{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bunch",
  "main": "worker.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bunch",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "vars": {
    "JUDGING_MODE": "seeded"
  },
  "observability": {
    "enabled": true
  }
}
