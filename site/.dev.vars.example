# Safe default: stored sample judgments only, no external AI calls.
JUDGING_MODE=seeded
# To enable live checking deliberately, set JUDGING_MODE=live and add GROQ_API_KEY.

# AI drafting is separately disabled. Enabling judging does not enable drafts.
GENERATION_MODE=disabled

# Optional private admin access: set a unique 32+ character password locally.
# Configure the real ADMIN_PASSWORD as a Secret in Cloudflare, never in Git.
