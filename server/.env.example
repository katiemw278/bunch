# Copy this file to .env and fill in your values.

# OpenAI API key — required for live AI judging.
# Leave blank to run in DEV MODE with seeded mock judgments.
OPENAI_API_KEY=

# Set to "true" to force dev mode even if OPENAI_API_KEY is set.
DEV_MODE=false

# Port for the API server (default: 3001)
PORT=3001

# Allowed origin for CORS (default: http://localhost:3000)
CLIENT_ORIGIN=http://localhost:3000
